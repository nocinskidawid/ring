<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Click"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Click"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="Save_As_Click"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtEditor" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" Text="" AcceptsTab="True"></TextBox>
        <Menu>
            <MenuItem Header="Plik">
                <MenuItem Header="Nowy" InputGestureText="Ctrl+N" Command="ApplicationCommands.New">
                    <MenuItem.Icon>
                        <Image Source="/pobrane.jpg"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Otwórz" InputGestureText="Ctrl+O" Command="ApplicationCommands.Open"></MenuItem>
                <MenuItem Header="Zapisz" InputGestureText="Ctrl+S" Command="ApplicationCommands.Save"></MenuItem>
                <MenuItem Header="Zapisz Jako" InputGestureText="Ctrl+Shift+S" Command="{x:Static local:MainWindow.SaveAsCommand}"></MenuItem>
            </MenuItem>
            <MenuItem Header="Edycja">
                <MenuItem Header="Edytuj kolor">
                    <MenuItem Header="Żółty" Tag="Zo" Click="Edit_Color_Click">
                        <MenuItem.Icon>
                            <Image Source="/zo.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zielony" Tag="Zi" Click="Edit_Color_Click">
                        <MenuItem.Icon>
                            <Image Source="/zi.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Czerwony" Tag="C" Click="Edit_Color_Click">
                        <MenuItem.Icon>
                            <Image Source="/c.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Czcionka">
                    <MenuItem Header="Rozmiar czcionki 12" Tag="12" Click="Edit_Font_Size_Click"></MenuItem>
                    <MenuItem Header="Rozmiar czcionki 15" Tag="15" Click="Edit_Font_Size_Click"></MenuItem>
                    <MenuItem Header="Rozmiar czcionki 18" Tag="18" Click="Edit_Font_Size_Click"></MenuItem>
                    <MenuItem Header="Rozmiar czcionki 22" Tag="22" Click="Edit_Font_Size_Click"></MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="O Programie" Click="About_Click">
                <MenuItem.ToolTip>Informacje O Osobie</MenuItem.ToolTip>
            </MenuItem>
            <MenuItem Header="Zamknij" Click="Close_Click"></MenuItem>
        </Menu>
    </Grid>
</Window>
